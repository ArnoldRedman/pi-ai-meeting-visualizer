{
  "name": "pi-ai-meeting-visualizer",
  "version": "0.8.0",
  "description": "浏览器中的 AI 会议室可视化插件",
  "private": true,
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions/",
    "lib/",
    "server/",
    "web/",
