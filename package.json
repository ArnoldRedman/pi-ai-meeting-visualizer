    "assets:fetch": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "three": "0.180.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
